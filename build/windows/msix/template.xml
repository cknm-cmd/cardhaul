<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="cardhaul"
        Arguments=""
        InstallLocation="C:\Program Files\cknm-cmd\CardHaul">
    </Installer>
    <PackageInformation
        PackageName="CardHaul"
        PackageDisplayName="CardHaul"
        PublisherName="CN=cknm-cmd"
        PublisherDisplayName="cknm-cmd"
        Version="0.1.0.0"
        PackageDescription="Plug in a camera or SD card; new footage uploads one-way to Google Drive and is verified.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.cknm-cmd.cardhaul"
                Description="Plug in a camera or SD card; new footage uploads one-way to Google Drive and is verified."
                DisplayName="CardHaul"
                ExecutableName="cardhaul"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>CardHaul</DisplayName>
            <PublisherDisplayName>cknm-cmd</PublisherDisplayName>
            <Description>Plug in a camera or SD card; new footage uploads one-way to Google Drive and is verified.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="cardhaul.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
